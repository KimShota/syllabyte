# --- Infra (local Docker Compose defaults) ---
SYLLABYTE_MONGO_URI=mongodb://localhost:27017
SYLLABYTE_MONGO_DB=syllabyte
SYLLABYTE_REDIS_URL=redis://localhost:6379/0
SYLLABYTE_S3_ENDPOINT=http://localhost:9000
SYLLABYTE_BUCKET=syllabyte-dev
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# --- LLM APIs ---
# ANTHROPIC_API_KEY is required now for the Week-1 pipeline (KU extraction,
# script generation + critique, Manim code generation) — see
# plan/week1-shorts-from-slides-plan.md. Loaded automatically via .env by
# packages/common/syllabyte_common/llm.py.
ANTHROPIC_API_KEY=
# Optional second key. Set ANTHROPIC_KEY_NAME=ANTHROPIC_API_KEY_2 to make the pipeline use it
# (the default is ANTHROPIC_API_KEY).
ANTHROPIC_API_KEY_2=
ANTHROPIC_KEY_NAME=
# Not used by the Week-1 pipeline (no GPT-4V visual critic this week —
# animation_agent/visual_critic.py uses Claude instead). Kept here for the
# October+ proposal scope.
OPENAI_API_KEY=
# Optional — local vLLM server (e.g. Qwen on the lab's DGX Spark). Pass
# model="local-qwen3.8-27b"; needs `ssh -N -L 8000:localhost:8000 <spark>` first.
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_API_KEY=local-secret
# Optional — only used if --tts elevenlabs is passed. Week-1 defaults to
# free local Kokoro TTS (see animation_agent/tts.py).
ELEVENLABS_API_KEY=
