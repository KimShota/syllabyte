# Environment / secrets — NEVER commit the real .env
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Docker volumes (bind-mounted local data, not source)
mongo_data/
minio_data/

# Manim output
media/
*.mp4
*.mov

# Whisper model cache
.cache/whisper/

# OS junk
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Week-1 pipeline: course inputs and generated run artifacts (large, local-only)
/data/
runs/

# uv lockfile is fine to commit, but keep local venvs out
.uv-cache/
