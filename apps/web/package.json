{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "FIXTURES_WEBM=1 npm run fixtures && NEXT_PUBLIC_TEST_WEBM=1 npm run build && playwright test",
    "fixtures": "node scripts/copy-fixtures.mjs",
    "predev": "node ../../packages/core/scripts/sync-consent.mjs && node scripts/check-fixtures.mjs",
    "prebuild": "node ../../packages/core/scripts/sync-consent.mjs && node scripts/check-fixtures.mjs",
    "shots": "FIXTURES_WEBM=1 npm run fixtures && NEXT_PUBLIC_TEST_WEBM=1 npm run build && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@syllabyte/core": "file:../../packages/core",
    "clsx": "^2.1.1",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
