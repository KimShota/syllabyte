# Copy to apps/server/.env. The server loads that Git-ignored file automatically.
RESEND_API_KEY=
MAIL_FROM="SyllaByte <signin@syllabyte.app>"
# Required in production. Locally, links use the API address the phone called.
# SYLLABYTE_PUBLIC_URL=https://api.syllabyte.app
# Optional additional EXACT sign-in return URLs, comma-separated (e.g. a web app).
# SYLLABYTE_AUTH_REDIRECT_URLS=https://syllabyte.app/signin
# PORT=8790
# SYLLABYTE_WORKER_TOKEN=your-worker-token
