# Until the domain exists: plain HTTP on port 80, for testing only (phones' production builds refuse HTTP).
:80 {
	reverse_proxy 127.0.0.1:8788
}

# With a domain (point its DNS A record at the droplet first), replace the block above with:
#
# api.example.com {
# 	reverse_proxy 127.0.0.1:8788
# }
#
# Caddy then gets and renews the HTTPS certificate by itself.
