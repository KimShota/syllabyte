{
  "expo": {
    "name": "SyllaByte",
    "slug": "syllabyte",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "edu.nyu.syllabyte"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B3FD6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "edu.nyu.syllabyte"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-video",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "SyllaByte uses your photos so you can choose a profile picture.",
          "cameraPermission": "SyllaByte uses the camera so you can take a profile picture."
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "syllabyte",
    "experiments": {
      "typedRoutes": true
    }
  }
}
